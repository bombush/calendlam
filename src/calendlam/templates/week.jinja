<div class="page-editable page">
    {% if kind == "week" %}
    <div class="tiskovy-obrazec">
        <div class="header-editable">
            <div class="header-text-editable header-text-font-editable">{{ header | upper }}</div>
        </div>
        {% for day in days %}
        <div class="date-row-editable date-row">
            <div class="number-block number-block-editable">
                <div class="number-block-number-editable number-block-number-font-editable">{{ day.day_number }}</div>
                <div class="day-cz-editable day-cz-font-editable">{{ day.day_cz }}</div>
            </div>
            <div class="bottom-line bottom-line-editable"></div>
            <div class="divider-editable divider-q1-editable"></div>
            <div class="divider-editable divider-q3-editable"></div>
        </div>
        {% endfor %}
    </div>
    {% elif kind == "months" %}
    <div class="months-grid">
        {% for month in months %}
        <div class="month-col">
            <div class="header-editable">
                <div class="header-text-editable header-text-font-editable">{{ month.header | upper }}</div>
            </div>
            {% for day in month.days %}
            <div class="month-row">
                <span class="month-row-number number-block-number-font-editable">{{ day.day_number }}</span>
                <span class="month-row-day day-cz-font-editable">{{ day.day_abbr }}</span>
            </div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {% if info %}
    <div class="page-info rubik-regular">{{ info }}</div>
    {% endif %}
</div>
